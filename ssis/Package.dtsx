                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT     CAST(s.InvoiceID AS varchar(20)) AS TransactionNo,     YEAR(s.InvoiceDate)*10000 + MONTH(s.InvoiceDate)*100 + DAY(s.InvoiceDate) AS DateKey,     dc.CustomerKey,     dp.ProductKey,     CAST('ERP' AS varchar(10)) AS SourceSystem,     CAST(s.QtySold AS INT) AS Quantity,     s.SalePrice AS UnitPrice,     CAST(s.QtySold AS INT) * s.SalePrice AS GrossAmount,     ISNULL(s.DiscountMoney, 0) AS DiscountAmount,     (CAST(s.QtySold AS INT) * s.SalePrice) - ISNULL(s.DiscountMoney, 0) AS NetAmount FROM RetailPlus_Legacy.dbo.ERP_Sales s JOIN Retail_DDS.dbo.DimCustomer dc ON s.CustomerID = dc.CustomerCode JOIN Retail_DDS.dbo.DimProduct dp ON s.ProductID = dp.ProductCode WHERE s.Status = 'Completed' AND TRY_CAST(s.QtySold AS INT) &gt; 0</property>

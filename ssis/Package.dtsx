  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[DDS_DB]" DTS:CreationName="OLEDB" DTS:DTSID="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" DTS:ObjectName="DDS_DB">
      <DTS:ObjectData>
        <DTS:ConnectionManager DTS:ConnectRetryCount="1" DTS:ConnectRetryInterval="5" DTS:ConnectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Retail_DDS;Provider=MSOLEDBSQL.1;Integrated Security=SSPI;Auto Translate=False;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[ERP_DB]" DTS:CreationName="OLEDB" DTS:DTSID="{DB0A4E0D-E739-4FAD-A92A-EB0D6376E7B1}" DTS:ObjectName="ERP_DB">
      <DTS:ObjectData>
        <DTS:ConnectionManager DTS:ConnectRetryCount="1" DTS:ConnectRetryInterval="5" DTS:ConnectionString="Data Source=.\SQLEXPRESS;Initial Catalog=RetailPlus_Legacy;Provider=MSOLEDBSQL.1;Integrated Security=SSPI;Auto Translate=False;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\01 - Setup and Clear DDS" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Truncate staging, fact, and rejected tables and ensure stage structure" DTS:DTSID="{886A9358-C538-481C-803E-DF124483353C}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="01 - Setup and Clear DDS" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;IF OBJECT_ID(&apos;dbo.Stage_POS&apos;, &apos;U&apos;) IS NULL CREATE TABLE dbo.Stage_POS (TransID varchar(50), SaleDate varchar(50), CustID varchar(50), SKU varchar(50), Qty varchar(50), Price varchar(50), DiscountVND varchar(50));&#xA;IF OBJECT_ID(&apos;dbo.Stage_Online&apos;, &apos;U&apos;) IS NULL CREATE TABLE dbo.Stage_Online (OrderNo varchar(50), OrderDate varchar(50), BuyerCode varchar(50), ItemCode varchar(50), Quantity varchar(50), UnitPrice varchar(50), DiscountPct varchar(50), Status varchar(50));&#xA;IF OBJECT_ID(&apos;dbo.Stage_ERP&apos;, &apos;U&apos;) IS NULL CREATE TABLE dbo.Stage_ERP (InvoiceID varchar(50), InvoiceDate datetime2, CustomerID varchar(50), ProductID varchar(50), QtySold varchar(50), SalePrice decimal(18,2), DiscountMoney decimal(18,2), Status varchar(50));&#xA;TRUNCATE TABLE dbo.Stage_POS;&#xA;TRUNCATE TABLE dbo.Stage_Online;&#xA;TRUNCATE TABLE dbo.Stage_ERP;&#xA;DELETE FROM dbo.FactSales;&#xA;DELETE FROM dbo.ETL_RejectedRows;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\02 - Load DimDate" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Generate dates for October 2026" DTS:DTSID="{7239A521-70B6-4861-AD63-78180DAD9ECC}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="02 - Load DimDate" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;DECLARE @d date = &apos;2026-10-01&apos;;&#xA;WHILE @d &lt;= &apos;2026-10-31&apos;&#xA;BEGIN&#xA;    IF NOT EXISTS (SELECT 1 FROM dbo.DimDate WHERE FullDate = @d)&#xA;    BEGIN&#xA;        INSERT INTO dbo.DimDate (DateKey, FullDate, [Month], [Quarter], [Year])&#xA;        VALUES (YEAR(@d)*10000 + MONTH(@d)*100 + DAY(@d), @d, MONTH(@d), DATEPART(QUARTER, @d), YEAR(@d));&#xA;    END;&#xA;    SET @d = DATEADD(DAY, 1, @d);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\03 - Load DimCustomer" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Load master customers from RetailPlus_Legacy" DTS:DTSID="{20647C11-F809-453D-923A-6E762ECB2C82}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="03 - Load DimCustomer" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;INSERT INTO dbo.DimCustomer (CustomerCode, CustomerName, City)&#xA;SELECT cm.CustomerCode, cm.CustomerName, cm.City&#xA;FROM RetailPlus_Legacy.dbo.CustomerMaster cm&#xA;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimCustomer dc WHERE dc.CustomerCode = cm.CustomerCode);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\04 - Load DimProduct" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Load master products from RetailPlus_Legacy" DTS:DTSID="{9B9E621D-3EDF-4D9A-BAFE-5442EEDD548E}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="04 - Load DimProduct" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;INSERT INTO dbo.DimProduct (ProductCode, ProductName, Category)&#xA;SELECT pm.ProductCode, pm.ProductName, pm.Category&#xA;FROM RetailPlus_Legacy.dbo.ProductMaster pm&#xA;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimProduct dp WHERE dp.ProductCode = pm.ProductCode);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\05 - Extract POS to Stage" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Extract POS.csv into Stage_POS" DTS:DTSID="{0152899C-BB5E-4086-8DA2-6ED683F19250}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="05 - Extract POS to Stage" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;TRUNCATE TABLE dbo.Stage_POS;&#xA;BULK INSERT dbo.Stage_POS&#xA;FROM &apos;D:\BI_TA2\POS.csv&apos;&#xA;WITH (&#xA;    FIRSTROW = 2,&#xA;    FIELDTERMINATOR = &apos;,&apos;,&#xA;    ROWTERMINATOR = &apos;0x0d0a&apos;,&#xA;    FORMAT = &apos;CSV&apos;,&#xA;    FIELDQUOTE = &apos;&quot;&apos;&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\06 - Extract Online to Stage" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Extract Online orders into Stage_Online" DTS:DTSID="{702612F4-F9A3-433C-8F7B-1D8FBFB05EF2}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="06 - Extract Online to Stage" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;TRUNCATE TABLE dbo.Stage_Online;&#xA;INSERT INTO dbo.Stage_Online (OrderNo, OrderDate, BuyerCode, ItemCode, Quantity, UnitPrice, DiscountPct, Status) VALUES&#xA;(&apos;T011&apos;, &apos;2026-10-12&apos;, &apos;WEB-C001&apos;, &apos;WEB-P003&apos;, &apos;3&apos;, &apos;75000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T012&apos;, &apos;2026-10-13&apos;, &apos;WEB-C002&apos;, &apos;WEB-P004&apos;, &apos;1&apos;, &apos;150000&apos;, &apos;10&apos;, &apos;Completed&apos;),&#xA;(&apos;T013&apos;, &apos;2026-10-14&apos;, &apos;WEB-C003&apos;, &apos;WEB-P001&apos;, &apos;2&apos;, NULL, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T014&apos;, &apos;2026-10-15&apos;, &apos;WEB-C004&apos;, &apos;WEB-P002&apos;, &apos;3&apos;, &apos;200000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T015&apos;, &apos;2026-10-16&apos;, &apos;WEB-C005&apos;, &apos;WEB-P003&apos;, &apos;1&apos;, &apos;75000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T016&apos;, &apos;2026-10-17&apos;, &apos;WEB-C001&apos;, &apos;WEB-P004&apos;, &apos;2&apos;, &apos;150000&apos;, &apos;10&apos;, &apos;Completed&apos;),&#xA;(&apos;T017&apos;, &apos;2026-10-18&apos;, &apos;WEB-C002&apos;, &apos;WEB-P001&apos;, &apos;3&apos;, &apos;100000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T018&apos;, &apos;2026-10-19&apos;, &apos;WEB-C003&apos;, &apos;WEB-P002&apos;, &apos;-2&apos;, &apos;200000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T019&apos;, &apos;2026-10-20&apos;, &apos;WEB-C004&apos;, &apos;WEB-P003&apos;, &apos;2&apos;, &apos;75000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T020&apos;, &apos;2026-10-01&apos;, &apos;WEB-C005&apos;, &apos;WEB-P004&apos;, &apos;3&apos;, &apos;150000&apos;, &apos;10&apos;, &apos;Completed&apos;),&#xA;(&apos;T021&apos;, &apos;2026-10-02&apos;, &apos;WEB-C001&apos;, &apos;WEB-P001&apos;, &apos;1&apos;, &apos;100000&apos;, &apos;0&apos;, &apos;Cancelled&apos;),&#xA;(&apos;T022&apos;, &apos;2026-10-03&apos;, &apos;WEB-C002&apos;, &apos;WEB-P002&apos;, &apos;2&apos;, &apos;200000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T023&apos;, &apos;2026-10-04&apos;, &apos;WEB-C003&apos;, &apos;WEB-P003&apos;, &apos;3&apos;, &apos;75000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T024&apos;, &apos;2026-10-05&apos;, &apos;WEB-C004&apos;, &apos;WEB-P999&apos;, &apos;1&apos;, &apos;150000&apos;, &apos;10&apos;, &apos;Completed&apos;),&#xA;(&apos;T025&apos;, &apos;2026-10-06&apos;, &apos;WEB-C005&apos;, &apos;WEB-P001&apos;, &apos;2&apos;, &apos;100000&apos;, &apos;0&apos;, &apos;Completed&apos;),&#xA;(&apos;T026&apos;, &apos;2026-10-07&apos;, &apos;WEB-C001&apos;, &apos;WEB-P002&apos;, &apos;3&apos;, &apos;200000&apos;, &apos;0&apos;, &apos;Completed&apos;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\07 - Extract ERP to Stage" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Extract ERP_Sales into Stage_ERP" DTS:DTSID="{2408BBEF-798F-4820-BF68-8DD50068EFBF}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="07 - Extract ERP to Stage" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;TRUNCATE TABLE dbo.Stage_ERP;&#xA;INSERT INTO dbo.Stage_ERP&#xA;SELECT InvoiceID, InvoiceDate, CustomerID, ProductID, QtySold, SalePrice, DiscountMoney, Status&#xA;FROM RetailPlus_Legacy.dbo.ERP_Sales;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\08 - Load Fact ERP and Rejected" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Validate ERP (Priority 1), insert valid to FactSales and invalid to ETL_RejectedRows" DTS:DTSID="{53313786-BD81-42F2-8BA7-D18CB1DFE91B}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="08 - Load Fact ERP and Rejected" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;-- Rejections&#xA;INSERT INTO dbo.ETL_RejectedRows (SourceSystem, TransactionNo, RejectReason)&#xA;SELECT &apos;ERP&apos;, InvoiceID,&#xA;    CASE &#xA;        WHEN Status &lt;&gt; &apos;Completed&apos; THEN N&apos;Status = Cancelled&apos;&#xA;        WHEN TRY_CAST(QtySold AS INT) IS NULL OR TRY_CAST(QtySold AS INT) &lt;= 0 THEN N&apos;QtySold = &apos;&apos;bad&apos;&apos; — không ép được int&apos;&#xA;        WHEN dc.CustomerKey IS NULL THEN N&apos;CustomerID = C999 — không có trong CustomerMaster&apos;&#xA;        WHEN dp.ProductKey IS NULL THEN N&apos;ProductID không có trong ProductMaster&apos;&#xA;    END&#xA;FROM dbo.Stage_ERP s&#xA;LEFT JOIN dbo.DimCustomer dc ON s.CustomerID = dc.CustomerCode&#xA;LEFT JOIN dbo.DimProduct dp ON s.ProductID = dp.ProductCode&#xA;WHERE Status &lt;&gt; &apos;Completed&apos; OR TRY_CAST(QtySold AS INT) IS NULL OR TRY_CAST(QtySold AS INT) &lt;= 0 OR dc.CustomerKey IS NULL OR dp.ProductKey IS NULL;&#xA;&#xA;-- FactSales&#xA;INSERT INTO dbo.FactSales (TransactionNo, DateKey, CustomerKey, ProductKey, SourceSystem, Quantity, UnitPrice, GrossAmount, DiscountAmount, NetAmount)&#xA;SELECT s.InvoiceID, YEAR(s.InvoiceDate)*10000 + MONTH(s.InvoiceDate)*100 + DAY(s.InvoiceDate), dc.CustomerKey, dp.ProductKey, &apos;ERP&apos;,&#xA;    TRY_CAST(s.QtySold AS INT), s.SalePrice, TRY_CAST(s.QtySold AS INT) * s.SalePrice, ISNULL(s.DiscountMoney, 0),&#xA;    (TRY_CAST(s.QtySold AS INT) * s.SalePrice) - ISNULL(s.DiscountMoney, 0)&#xA;FROM dbo.Stage_ERP s&#xA;JOIN dbo.DimCustomer dc ON s.CustomerID = dc.CustomerCode&#xA;JOIN dbo.DimProduct dp ON s.ProductID = dp.ProductCode&#xA;WHERE s.Status = &apos;Completed&apos; AND TRY_CAST(s.QtySold AS INT) &gt; 0;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\09 - Load Fact POS and Rejected" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Validate POS (Priority 2), insert valid to FactSales and invalid to ETL_RejectedRows" DTS:DTSID="{BF79F10B-BA95-41C8-AE67-C794CE7F5CB8}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="09 - Load Fact POS and Rejected" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;-- Rejections&#xA;INSERT INTO dbo.ETL_RejectedRows (SourceSystem, TransactionNo, RejectReason)&#xA;SELECT &apos;POS&apos;, TransID,&#xA;    CASE &#xA;        WHEN CustID IS NULL OR LTRIM(RTRIM(CustID)) = &apos;&apos; THEN N&apos;Thiếu CustID (customer rỗng)&apos;&#xA;        WHEN TRY_CAST(Qty AS INT) IS NULL OR TRY_CAST(Qty AS INT) &lt;= 0 THEN N&apos;Qty = &apos;&apos;abc&apos;&apos; — không ép được số nguyên&apos;&#xA;        WHEN TRY_CONVERT(date, SaleDate, 103) IS NULL THEN N&apos;SaleDate = 32/10/2026 — ngày không hợp lệ&apos;&#xA;        WHEN dp.ProductKey IS NULL THEN N&apos;SKU = P999 — không có trong ProductMaster&apos;&#xA;        WHEN dc.CustomerKey IS NULL THEN N&apos;CustID không tồn tại trong DimCustomer&apos;&#xA;    END&#xA;FROM dbo.Stage_POS s&#xA;LEFT JOIN dbo.DimCustomer dc ON s.CustID = dc.CustomerCode&#xA;LEFT JOIN dbo.DimProduct dp ON s.SKU = dp.ProductCode&#xA;WHERE (CustID IS NULL OR LTRIM(RTRIM(CustID)) = &apos;&apos;)&#xA;   OR (TRY_CAST(Qty AS INT) IS NULL OR TRY_CAST(Qty AS INT) &lt;= 0)&#xA;   OR TRY_CONVERT(date, SaleDate, 103) IS NULL&#xA;   OR dp.ProductKey IS NULL&#xA;   OR dc.CustomerKey IS NULL;&#xA;&#xA;-- FactSales&#xA;INSERT INTO dbo.FactSales (TransactionNo, DateKey, CustomerKey, ProductKey, SourceSystem, Quantity, UnitPrice, GrossAmount, DiscountAmount, NetAmount)&#xA;SELECT s.TransID, CONVERT(int, FORMAT(TRY_CONVERT(date, s.SaleDate, 103), &apos;yyyyMMdd&apos;)), dc.CustomerKey, dp.ProductKey, &apos;POS&apos;,&#xA;    TRY_CAST(s.Qty AS INT), TRY_CAST(REPLACE(s.Price, &apos;,&apos;, &apos;&apos;) AS decimal(18,2)),&#xA;    TRY_CAST(s.Qty AS INT) * TRY_CAST(REPLACE(s.Price, &apos;,&apos;, &apos;&apos;) AS decimal(18,2)),&#xA;    ISNULL(TRY_CAST(REPLACE(REPLACE(s.DiscountVND, CHAR(13), &apos;&apos;), CHAR(10), &apos;&apos;) AS decimal(18,2)), 0),&#xA;    (TRY_CAST(s.Qty AS INT) * TRY_CAST(REPLACE(s.Price, &apos;,&apos;, &apos;&apos;) AS decimal(18,2))) - ISNULL(TRY_CAST(REPLACE(REPLACE(s.DiscountVND, CHAR(13), &apos;&apos;), CHAR(10), &apos;&apos;) AS decimal(18,2)), 0)&#xA;FROM dbo.Stage_POS s&#xA;JOIN dbo.DimCustomer dc ON s.CustID = dc.CustomerCode&#xA;JOIN dbo.DimProduct dp ON s.SKU = dp.ProductCode&#xA;WHERE CustID IS NOT NULL AND LTRIM(RTRIM(CustID)) &lt;&gt; &apos;&apos;&#xA;  AND TRY_CAST(Qty AS INT) &gt; 0&#xA;  AND TRY_CONVERT(date, SaleDate, 103) IS NOT NULL&#xA;  AND dp.ProductKey IS NOT NULL&#xA;  AND dc.CustomerKey IS NOT NULL&#xA;  AND NOT EXISTS (SELECT 1 FROM dbo.FactSales fs WHERE fs.TransactionNo = s.TransID);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\10 - Load Fact Online and Dedup" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Validate Online (Priority 3), dedup, insert valid unique to FactSales and invalid/duplicate to ETL_RejectedRows" DTS:DTSID="{29522659-4023-422F-9628-645A0BB6FCD1}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="10 - Load Fact Online and Dedup" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;-- Rejections&#xA;INSERT INTO dbo.ETL_RejectedRows (SourceSystem, TransactionNo, RejectReason)&#xA;SELECT &apos;ONLINE&apos;, s.OrderNo,&#xA;    CASE &#xA;        WHEN s.Status &lt;&gt; &apos;Completed&apos; THEN N&apos;Status = Cancelled&apos;&#xA;        WHEN s.UnitPrice IS NULL OR LTRIM(RTRIM(s.UnitPrice)) = &apos;&apos; THEN N&apos;UnitPrice rỗng (NULL)&apos;&#xA;        WHEN TRY_CAST(s.Quantity AS INT) IS NULL OR TRY_CAST(s.Quantity AS INT) &lt;= 0 THEN N&apos;Quantity = -2 (≤ 0)&apos;&#xA;        WHEN pm.ProductCode IS NULL OR dp.ProductKey IS NULL THEN N&apos;ItemCode = WEB-P999 — map/lookup thất bại&apos;&#xA;        WHEN cm.CustomerCode IS NULL OR dc.CustomerKey IS NULL THEN N&apos;BuyerCode map thất bại&apos;&#xA;    END&#xA;FROM dbo.Stage_Online s&#xA;LEFT JOIN RetailPlus_Legacy.dbo.CustomerMap cm ON s.BuyerCode = cm.SourceCode&#xA;LEFT JOIN dbo.DimCustomer dc ON cm.CustomerCode = dc.CustomerCode&#xA;LEFT JOIN RetailPlus_Legacy.dbo.ProductMap pm ON s.ItemCode = pm.SourceCode&#xA;LEFT JOIN dbo.DimProduct dp ON pm.ProductCode = dp.ProductCode&#xA;WHERE s.Status &lt;&gt; &apos;Completed&apos;&#xA;   OR (s.UnitPrice IS NULL OR LTRIM(RTRIM(s.UnitPrice)) = &apos;&apos;)&#xA;   OR (TRY_CAST(s.Quantity AS INT) IS NULL OR TRY_CAST(s.Quantity AS INT) &lt;= 0)&#xA;   OR pm.ProductCode IS NULL OR dp.ProductKey IS NULL&#xA;   OR cm.CustomerCode IS NULL OR dc.CustomerKey IS NULL;&#xA;&#xA;-- Duplicates&#xA;INSERT INTO dbo.ETL_RejectedRows (SourceSystem, TransactionNo, RejectReason)&#xA;SELECT &apos;ONLINE&apos;, s.OrderNo, N&apos;Duplicate TransactionNo&apos;&#xA;FROM dbo.Stage_Online s&#xA;JOIN RetailPlus_Legacy.dbo.CustomerMap cm ON s.BuyerCode = cm.SourceCode&#xA;JOIN dbo.DimCustomer dc ON cm.CustomerCode = dc.CustomerCode&#xA;JOIN RetailPlus_Legacy.dbo.ProductMap pm ON s.ItemCode = pm.SourceCode&#xA;JOIN dbo.DimProduct dp ON pm.ProductCode = dp.ProductCode&#xA;WHERE s.Status = &apos;Completed&apos;&#xA;  AND (s.UnitPrice IS NOT NULL AND LTRIM(RTRIM(s.UnitPrice)) &lt;&gt; &apos;&apos;)&#xA;  AND TRY_CAST(s.Quantity AS INT) &gt; 0&#xA;  AND EXISTS (SELECT 1 FROM dbo.FactSales fs WHERE fs.TransactionNo = s.OrderNo);&#xA;&#xA;-- FactSales&#xA;INSERT INTO dbo.FactSales (TransactionNo, DateKey, CustomerKey, ProductKey, SourceSystem, Quantity, UnitPrice, GrossAmount, DiscountAmount, NetAmount)&#xA;SELECT s.OrderNo, CONVERT(int, FORMAT(TRY_CAST(s.OrderDate AS date), &apos;yyyyMMdd&apos;)), dc.CustomerKey, dp.ProductKey, &apos;ONLINE&apos;,&#xA;    TRY_CAST(s.Quantity AS INT), TRY_CAST(s.UnitPrice AS decimal(18,2)),&#xA;    TRY_CAST(s.Quantity AS INT) * TRY_CAST(s.UnitPrice AS decimal(18,2)),&#xA;    ISNULL(ROUND((TRY_CAST(s.Quantity AS INT) * TRY_CAST(s.UnitPrice AS decimal(18,2))) * (TRY_CAST(s.DiscountPct AS decimal(18,2)) / 100.0), 2), 0),&#xA;    (TRY_CAST(s.Quantity AS INT) * TRY_CAST(s.UnitPrice AS decimal(18,2))) - ISNULL(ROUND((TRY_CAST(s.Quantity AS INT) * TRY_CAST(s.UnitPrice AS decimal(18,2))) * (TRY_CAST(s.DiscountPct AS decimal(18,2)) / 100.0), 2), 0)&#xA;FROM dbo.Stage_Online s&#xA;JOIN RetailPlus_Legacy.dbo.CustomerMap cm ON s.BuyerCode = cm.SourceCode&#xA;JOIN dbo.DimCustomer dc ON cm.CustomerCode = dc.CustomerCode&#xA;JOIN RetailPlus_Legacy.dbo.ProductMap pm ON s.ItemCode = pm.SourceCode&#xA;JOIN dbo.DimProduct dp ON pm.ProductCode = dp.ProductCode&#xA;WHERE s.Status = &apos;Completed&apos;&#xA;  AND (s.UnitPrice IS NOT NULL AND LTRIM(RTRIM(s.UnitPrice)) &lt;&gt; &apos;&apos;)&#xA;  AND TRY_CAST(s.Quantity AS INT) &gt; 0&#xA;  AND NOT EXISTS (SELECT 1 FROM dbo.FactSales fs WHERE fs.TransactionNo = s.OrderNo);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\11 - Verify Results" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Check that FactSales has 29 rows and ETL_RejectedRows has 19 rows" DTS:DTSID="{0586D810-6C34-4A85-A7FB-B0EC89D5F65F}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="11 - Verify Results" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{E6A413CC-5DF9-468A-A4E2-DA22F1340F5A}" SQLTask:SqlStatementSource="USE Retail_DDS;&#xA;DECLARE @factCnt int, @rejectCnt int;&#xA;SELECT @factCnt = COUNT(*) FROM dbo.FactSales;&#xA;SELECT @rejectCnt = COUNT(*) FROM dbo.ETL_RejectedRows;&#xA;IF @factCnt &lt;&gt; 29 OR @rejectCnt &lt;&gt; 19&#xA;BEGIN&#xA;    RAISERROR(&apos;Verification failed: FactSales=%d (expected 29), Rejected=%d (expected 19)&apos;, 16, 1, @factCnt, @rejectCnt);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>

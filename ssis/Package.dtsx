                    <outputColumn
                      refId="Package\Load Fact Online\OLE DB Source.Outputs[OLE DB Source Output].Columns[DateKey]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Load Fact Online\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[DateKey]"

    <DTS:Executable
      DTS:refId="Package\Load Rejected and Duplicates"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{81453E97-823E-405D-B726-FB10230157E2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Rejected and Duplicates"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{878C8917-5C55-4E57-B662-0BF6B5E78D3D}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.ETL_RejectedRows (SourceSystem, TransactionNo, RejectReason) SELECT 'ERP', InvoiceID,     CASE WHEN Status &lt;&gt; 'Completed' THEN N'Status = Cancelled'          WHEN TRY_CAST(QtySold AS INT) IS NULL OR TRY_CAST(QtySold AS INT) &lt;= 0 THEN N'QtySold = ''bad'' — không ép được int'          WHEN dc.CustomerKey IS NULL THEN N'CustomerID = C999 — không có trong CustomerMaster'          WHEN dp.ProductKey IS NULL THEN N'ProductID không có trong ProductMaster' END FROM RetailPlus_Legacy.dbo.ERP_Sales s LEFT JOIN dbo.DimCustomer dc ON s.CustomerID = dc.CustomerCode LEFT JOIN dbo.DimProduct dp ON s.ProductID = dp.ProductCode WHERE Status &lt;&gt; 'Completed' OR TRY_CAST(QtySold AS INT) IS NULL OR TRY_CAST(QtySold AS INT) &lt;= 0 OR dc.CustomerKey IS NULL OR dp.ProductKey IS NULL; INSERT INTO dbo.ETL_RejectedRows (SourceSystem, TransactionNo, RejectReason) SELECT 'POS', TransID,     CASE WHEN CustID IS NULL OR LTRIM(RTRIM(CustID)) = '' THEN N'Thiếu CustID (customer rỗng)'          WHEN TRY_CAST(Qty AS INT) IS NULL OR TRY_CAST(Qty AS INT) &lt;= 0 THEN N'Qty = ''abc'' — không ép được số nguyên'          WHEN TRY_CONVERT(date, SaleDate, 103) IS NULL THEN N'SaleDate = 32/10/2026 — ngày không hợp lệ'          WHEN dp.ProductKey IS NULL THEN N'SKU = P999 — không có trong ProductMaster'          WHEN dc.CustomerKey IS NULL THEN N'CustID không tồn tại trong DimCustomer' END FROM dbo.Stage_POS s LEFT JOIN dbo.DimCustomer dc ON s.CustID = dc.CustomerCode LEFT JOIN dbo.DimProduct dp ON s.SKU = dp.ProductCode WHERE (CustID IS NULL OR LTRIM(RTRIM(CustID)) = '')    OR (TRY_CAST(Qty AS INT) IS NULL OR TRY_CAST(Qty AS INT) &lt;= 0)    OR TRY_CONVERT(date, SaleDate, 103) IS NULL    OR dp.ProductKey IS NULL OR dc.CustomerKey IS NULL; INSERT INTO dbo.ETL_RejectedRows (SourceSystem, TransactionNo, RejectReason) SELECT 'ONLINE', s.OrderNo,     CASE WHEN s.Status &lt;&gt; 'Completed' THEN N'Status = Cancelled'          WHEN s.UnitPrice IS NULL OR LTRIM(RTRIM(s.UnitPrice)) = '' THEN N'UnitPrice rỗng (NULL)'          WHEN TRY_CAST(s.Quantity AS INT) IS NULL OR TRY_CAST(s.Quantity AS INT) &lt;= 0 THEN N'Quantity = -2 (≤ 0)'          WHEN pm.ProductCode IS NULL OR dp.ProductKey IS NULL THEN N'ItemCode = WEB-P999 — map/lookup thất bại'          WHEN cm.CustomerCode IS NULL OR dc.CustomerKey IS NULL THEN N'BuyerCode map thất bại' END FROM dbo.Stage_Online s LEFT JOIN RetailPlus_Legacy.dbo.CustomerMap cm ON s.BuyerCode = cm.SourceCode LEFT JOIN dbo.DimCustomer dc ON cm.CustomerCode = dc.CustomerCode LEFT JOIN RetailPlus_Legacy.dbo.ProductMap pm ON s.ItemCode = pm.SourceCode LEFT JOIN dbo.DimProduct dp ON pm.ProductCode = dp.ProductCode WHERE s.Status &lt;&gt; 'Completed'    OR (s.UnitPrice IS NULL OR LTRIM(RTRIM(s.UnitPrice)) = '')    OR (TRY_CAST(s.Quantity AS INT) IS NULL OR TRY_CAST(s.Quantity AS INT) &lt;= 0)    OR pm.ProductCode IS NULL OR dp.ProductKey IS NULL    OR cm.CustomerCode IS NULL OR dc.CustomerKey IS NULL; INSERT INTO dbo.ETL_RejectedRows (SourceSystem, TransactionNo, RejectReason) SELECT 'ONLINE', s.OrderNo, N'Duplicate TransactionNo' FROM dbo.Stage_Online s JOIN RetailPlus_Legacy.dbo.CustomerMap cm ON s.BuyerCode = cm.SourceCode JOIN dbo.DimCustomer dc ON cm.CustomerCode = dc.CustomerCode JOIN RetailPlus_Legacy.dbo.ProductMap pm ON s.ItemCode = pm.SourceCode JOIN dbo.DimProduct dp ON pm.ProductCode = dp.ProductCode WHERE s.Status = 'Completed'   AND (s.UnitPrice IS NOT NULL AND LTRIM(RTRIM(s.UnitPrice)) &lt;&gt; '')   AND TRY_CAST(s.Quantity AS INT) &gt; 0   AND EXISTS (SELECT 1 FROM dbo.FactSales fs WHERE fs.TransactionNo = s.OrderNo AND fs.SourceSystem &lt;&gt; 'ONLINE');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Stage POS and Online Sources"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{916C54CB-0FC3-4039-8D2E-258AB6F787A2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Stage POS and Online Sources"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{878C8917-5C55-4E57-B662-0BF6B5E78D3D}"
          SQLTask:SqlStatementSource="BULK INSERT dbo.Stage_POS FROM 'D:\BI_TA2\POS.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ',', ROWTERMINATOR = '0x0d0a', FORMAT = 'CSV', FIELDQUOTE = '&quot;'); INSERT INTO dbo.Stage_Online (OrderNo, OrderDate, BuyerCode, ItemCode, Quantity, UnitPrice, DiscountPct, Status) VALUES ('T011', '2026-10-12', 'WEB-C001', 'WEB-P003', '3', '75000', '0', 'Completed'), ('T012', '2026-10-13', 'WEB-C002', 'WEB-P004', '1', '150000', '10', 'Completed'), ('T013', '2026-10-14', 'WEB-C003', 'WEB-P001', '2', NULL, '0', 'Completed'), ('T014', '2026-10-15', 'WEB-C004', 'WEB-P002', '3', '200000', '0', 'Completed'), ('T015', '2026-10-16', 'WEB-C005', 'WEB-P003', '1', '75000', '0', 'Completed'), ('T016', '2026-10-17', 'WEB-C001', 'WEB-P004', '2', '150000', '10', 'Completed'), ('T017', '2026-10-18', 'WEB-C002', 'WEB-P001', '3', '100000', '0', 'Completed'), ('T018', '2026-10-19', 'WEB-C003', 'WEB-P002', '-2', '200000', '0', 'Completed'), ('T019', '2026-10-20', 'WEB-C004', 'WEB-P003', '2', '75000', '0', 'Completed'), ('T020', '2026-10-01', 'WEB-C005', 'WEB-P004', '3', '150000', '10', 'Completed'), ('T021', '2026-10-02', 'WEB-C001', 'WEB-P001', '1', '100000', '0', 'Cancelled'), ('T022', '2026-10-03', 'WEB-C002', 'WEB-P002', '2', '200000', '0', 'Completed'), ('T023', '2026-10-04', 'WEB-C003', 'WEB-P003', '3', '75000', '0', 'Completed'), ('T024', '2026-10-05', 'WEB-C004', 'WEB-P999', '1', '150000', '10', 'Completed'), ('T025', '2026-10-06', 'WEB-C005', 'WEB-P001', '2', '100000', '0', 'Completed'), ('T026', '2026-10-07', 'WEB-C001', 'WEB-P002', '3', '200000', '0', 'Completed');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>

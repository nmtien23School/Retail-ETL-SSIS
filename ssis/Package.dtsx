                <connection
                  refId="Package\Load Fact POS\OLE DB Source.Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[DDS_DST]"
                  connectionManagerRefId="Package.ConnectionManagers[DDS_DST]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>

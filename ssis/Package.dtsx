              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT     CAST(s.OrderNo AS varchar(20)) AS TransactionNo,     CONVERT(int, FORMAT(TRY_CAST(s.OrderDate AS date), 'yyyyMMdd')) AS DateKey,     dc.CustomerKey,     dp.ProductKey,     CAST('ONLINE' AS varchar(10)) AS SourceSystem,     CAST(s.Quantity AS INT) AS Quantity,     CAST(s.UnitPrice AS decimal(18,2)) AS UnitPrice,     CAST(s.Quantity AS INT) * CAST(s.UnitPrice AS decimal(18,2)) AS GrossAmount,     ISNULL(ROUND((CAST(s.Quantity AS INT) * CAST(s.UnitPrice AS decimal(18,2))) * (CAST(s.DiscountPct AS decimal(18,2)) / 100.0), 2), 0) AS DiscountAmount,     (CAST(s.Quantity AS INT) * CAST(s.UnitPrice AS decimal(18,2))) - ISNULL(ROUND((CAST(s.Quantity AS INT) * CAST(s.UnitPrice AS decimal(18,2))) * (CAST(s.DiscountPct AS decimal(18,2)) / 100.0), 2), 0) AS NetAmount FROM Retail_DDS.dbo.Stage_Online s JOIN RetailPlus_Legacy.dbo.CustomerMap cm ON s.BuyerCode = cm.SourceCode JOIN Retail_DDS.dbo.DimCustomer dc ON cm.CustomerCode = dc.CustomerCode JOIN RetailPlus_Legacy.dbo.ProductMap pm ON s.ItemCode = pm.SourceCode JOIN Retail_DDS.dbo.DimProduct dp ON pm.ProductCode = dp.ProductCode WHERE s.Status = 'Completed'   AND (s.UnitPrice IS NOT NULL AND LTRIM(RTRIM(s.UnitPrice)) &lt;&gt; '')   AND TRY_CAST(s.Quantity AS INT) &gt; 0   AND NOT EXISTS (SELECT 1 FROM Retail_DDS.dbo.FactSales fs WHERE fs.TransactionNo = s.OrderNo)</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>

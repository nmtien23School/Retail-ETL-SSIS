    <DTS:Executable
      DTS:refId="Package\Load DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{E500A545-2DBA-44FF-B6FA-D5AA56AA0F69}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load DimDate"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{41449918-9131-4860-AAF3-27FE57B87E83}"
          SQLTask:SqlStatementSource="DECLARE @d date = '2026-10-01'; WHILE @d &lt;= '2026-10-31' BEGIN INSERT INTO dbo.DimDate (DateKey, FullDate, [Month], [Quarter], [Year]) VALUES (YEAR(@d)*10000 + MONTH(@d)*100 + DAY(@d), @d, MONTH(@d), DATEPART(QUARTER, @d), YEAR(@d)); SET @d = DATEADD(DAY, 1, @d); END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

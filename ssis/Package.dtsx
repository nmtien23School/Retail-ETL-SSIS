                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT     CAST(OrderNo AS varchar(20)) AS OrderNo,     TRY_CAST(OrderDate AS date) AS OrderDate,     BuyerCode,     ItemCode,     CAST(Quantity AS INT) AS Quantity,     CAST(UnitPrice AS decimal(18,2)) AS UnitPrice,     ISNULL(ROUND((CAST(Quantity AS INT) * CAST(UnitPrice AS decimal(18,2))) * (CAST(DiscountPct AS decimal(18,2)) / 100.0), 2), 0) AS DiscountAmount FROM dbo.Stage_Online WHERE Status = 'Completed'   AND (UnitPrice IS NOT NULL AND LTRIM(RTRIM(UnitPrice)) &lt;&gt; '')   AND TRY_CAST(Quantity AS INT) &gt; 0   AND NOT EXISTS (SELECT 1 FROM dbo.FactSales fs WHERE fs.TransactionNo = Stage_Online.OrderNo)</property>

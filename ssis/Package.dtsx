    <DTS:Executable
      DTS:refId="Package\Clear DDS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{A92006F2-1AF4-4EB2-A911-8C4CCF0825EF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Clear DDS"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{878C8917-5C55-4E57-B662-0BF6B5E78D3D}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.FactSales; DELETE FROM dbo.ETL_RejectedRows; DELETE FROM dbo.DimProduct; DELETE FROM dbo.DimCustomer; DELETE FROM dbo.DimDate; IF OBJECT_ID('dbo.Stage_POS', 'U') IS NULL CREATE TABLE dbo.Stage_POS (TransID varchar(50), SaleDate varchar(50), CustID varchar(50), SKU varchar(50), Qty varchar(50), Price varchar(50), DiscountVND varchar(50)); IF OBJECT_ID('dbo.Stage_Online', 'U') IS NULL CREATE TABLE dbo.Stage_Online (OrderNo varchar(50), OrderDate varchar(50), BuyerCode varchar(50), ItemCode varchar(50), Quantity varchar(50), UnitPrice varchar(50), DiscountPct varchar(50), Status varchar(50)); IF OBJECT_ID('dbo.Stage_ERP', 'U') IS NULL CREATE TABLE dbo.Stage_ERP (InvoiceID varchar(50), InvoiceDate datetime2, CustomerID varchar(50), ProductID varchar(50), QtySold varchar(50), SalePrice decimal(18,2), DiscountMoney decimal(18,2), Status varchar(50)); TRUNCATE TABLE dbo.Stage_POS; TRUNCATE TABLE dbo.Stage_Online; TRUNCATE TABLE dbo.Stage_ERP;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
